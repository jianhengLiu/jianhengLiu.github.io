% github_stars.sty — publication badges: GitHub stars + citation counts
% Data is generated by
%   fetch_github_stars.py -> github_stars_data.tex   (owner/repo -> stars)
%   fetch_citations.py    -> citations_data.tex      (paper title -> citations)
% Citation counts are keyed by the *title argument* of the macros below, so the
% title only ever appears once in the source — no keys to keep in sync.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{github_stars}[2026/08/17 GitHub star and citation badges for CV]

\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fontawesome}

\definecolor{githubstarcolor}{HTML}{444d56}
\definecolor{githubstaricon}{HTML}{E3A008}
\definecolor{citationcolor}{HTML}{444d56}
\definecolor{citationicon}{HTML}{2F6FDB}
% Size of the badges; change to \footnotesize / \normalsize to taste.
\newcommand{\githubstarsize}{\small}
\newcommand{\citationsize}{\small}

% Load cached star counts (owner/repo -> number)
\InputIfFileExists{github_stars_data.tex}{}{%
  \PackageWarning{github_stars}{github_stars_data.tex not found; run fetch_github_stars.py}%
}
% Load cached citation counts (paper title -> number)
\InputIfFileExists{citations_data.tex}{}{%
  \PackageWarning{github_stars}{citations_data.tex not found; run fetch_citations.py}%
}

% \githubstars{owner/repo} — badge only (github star N)
\newcommand{\githubstars}[1]{%
  \ifcsname githubstar@#1\endcsname
    {\,\githubstarsize\textcolor{githubstarcolor}{\faGithub\,\textcolor{githubstaricon}{\faStar}\,\textbf{\csname githubstar@#1\endcsname}}}%
  \fi
}

% \citations{paper title} — badge only; prints nothing when the count is
% missing or zero, so uncited/new papers stay clean.
\newcommand{\citations}[1]{%
  \ifcsname citationcount@#1\endcsname
    {\,\citationsize\textcolor{citationcolor}{\faGraduationCap\,\textcolor{citationicon}{\faQuoteRight}\,\textbf{\csname citationcount@#1\endcsname}}}%
  \fi
}

% \ghhref{owner/repo}{title} — GitHub link + stars + citations
\newcommand{\ghhref}[2]{%
  \href{https://github.com/#1}{#2}\githubstars{#1}\citations{#2}%
}

% \paperhref{url}{owner/repo}{title} — arbitrary link + stars + citations
\newcommand{\paperhref}[3]{%
  \href{#1}{#3}\githubstars{#2}\citations{#3}%
}

% \pubhref{url}{title} — arbitrary link + citations (no repo)
\newcommand{\pubhref}[2]{%
  \href{#1}{#2}\citations{#2}%
}

% \pubtitle{title} — plain title + citations (no link, no repo)
\newcommand{\pubtitle}[1]{%
  #1\citations{#1}%
}
