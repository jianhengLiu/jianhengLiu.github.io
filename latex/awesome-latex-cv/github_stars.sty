% github_stars.sty — show GitHub star counts next to paper/code links
% Data is generated by fetch_github_stars.py into github_stars_data.tex
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{github_stars}[2026/08/17 GitHub star badges for CV]

\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fontawesome}

\definecolor{githubstarcolor}{HTML}{6a737d}

% Load cached star counts (owner/repo -> number)
\InputIfFileExists{github_stars_data.tex}{}{%
  \PackageWarning{github_stars}{github_stars_data.tex not found; run fetch_github_stars.py}%
}

% \githubstars{owner/repo} — badge only (★ N)
\newcommand{\githubstars}[1]{%
  \ifcsname githubstar@#1\endcsname
    {\,\textcolor{githubstarcolor}{\footnotesize\faGithub\,\faStar\,\csname githubstar@#1\endcsname}}%
  \fi
}

% \ghhref{owner/repo}{text} — link to GitHub + star badge
\newcommand{\ghhref}[2]{%
  \href{https://github.com/#1}{#2}\githubstars{#1}%
}

% \paperhref{url}{owner/repo}{text} — arbitrary link + stars from a repo
\newcommand{\paperhref}[3]{%
  \href{#1}{#3}\githubstars{#2}%
}
